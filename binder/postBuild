#!/bin/bash
# Bake the simulator and its predictor cache for the default model into the Binder
# image, so a student's first simulation starts in seconds instead of minutes.
set -euo pipefail
export PYTHONPATH="$PWD/labs:${PYTHONPATH:-}"
python -c "import llm_systems_wo_gpus as lsg; lsg.setup(); lsg.simulate(num_requests=5)"
